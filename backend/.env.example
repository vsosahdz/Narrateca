# Copiar a .env y ajustar. El archivo .env NUNCA se versiona.
# En GCP, estos valores provienen de Secret Manager, no de un archivo.

# --- Aplicación -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3400

# --- Base de datos ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://narrateca:narrateca@localhost:5433/narrateca
DATABASE_ECHO=false

# --- Seguridad --------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-en-produccion
SESSION_MAX_AGE_SECONDS=28800

# --- Archivo físico ---------------------------------------------------------
# Raíz común del material, con subcarpetas por comunidad. NUNCA se versiona.
ARCHIVE_ROOT=./archivo

# --- Almacenamiento de media ------------------------------------------------
# local | gcs
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/media
# Material sensible: bucket privado, siempre por URL firmada.
STORAGE_GCS_BUCKET_SENSITIVE=
# Material de difusión general.
STORAGE_GCS_BUCKET_PUBLIC=

# --- Modelo de lenguaje -----------------------------------------------------
# El proveedor vive detrás de una interfaz: cambiar de Ollama Cloud a Ollama
# local es cambiar estas variables, no el código (design.md, decisión 3).
#   echo   → respuesta simulada, para desarrollo sin proveedor
#   ollama → Ollama, sea en la nube o local, según LLM_BASE_URL
LLM_PROVIDER=echo
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3.1:70b
LLM_TIMEOUT_SECONDS=120

# --- Embeddings -------------------------------------------------------------
# SIEMPRE locales. Enviar el corpus a un servicio de embeddings externo anularía
# la restricción de confidencialidad completa (design.md, decisión 2).
EMBEDDINGS_PROVIDER=onnx
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
EMBEDDINGS_DIMENSIONS=384

# --- RAG --------------------------------------------------------------------
RAG_TOP_K=6
RAG_MIN_RELEVANCE=0.35
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# --- Conversaciones ---------------------------------------------------------
# 0 = sin caducidad automática (decisión: retención larga y anónima).
TRANSCRIPT_RETENTION_DAYS=0
